{
  "version": 2,
  "name": "rh-absenteismo-lube",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/diagnostico.js": {
      "maxDuration": 60
    },
    "api/assistente.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
